
# ============================================
# THE INVISIBLE HEALER
# PHASE 02 - ENVIRONMENT CONFIGURATION
# ============================================

# --------------------------------------------
# APPLICATION
# --------------------------------------------

APP_NAME="The Invisible Healer"
APP_VERSION="0.1.0"
# development | testing | production
APP_ENV=development
DEBUG=false

# --------------------------------------------
# API
# --------------------------------------------

API_V1_PREFIX=/api/v1

# --------------------------------------------
# DATABASE - SUPABASE POSTGRESQL
# --------------------------------------------

# Replace the placeholder with your connection
# string from Supabase Database Settings.
#
# URL-encode reserved characters in passwords.
#
# Phase 03 implements the actual connection.

DATABASE_URL=postgresql+psycopg://postgres:replace_me@localhost:5432/invisible_healer

# --------------------------------------------
# SUPABASE STORAGE
# --------------------------------------------

# Phase 18 activates document storage.
#
# Service-role credentials are backend-only.
# Never expose them in browser JavaScript.

STORAGE_ENABLED=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=clinical-documents

# --------------------------------------------
# ADMIN SESSION SECURITY
# --------------------------------------------

# Phase 06 implements Admin authentication.
#
# Keep disabled until session handling exists.

ADMIN_SESSIONS_ENABLED=false

# Use a cryptographically random secret.
# Minimum 32 characters when sessions enabled.

SESSION_SECRET=
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=lax
SESSION_MAX_AGE_SECONDS=3600

# --------------------------------------------
# OPTIONAL AI PROVIDERS
# --------------------------------------------

# Not required during Phase 02.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --------------------------------------------
# LOGGING
# --------------------------------------------

LOG_LEVEL=INFO

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_POOL_RECYCLE=1800
DB_CONNECT_TIMEOUT=10
DB_ECHO=false